{
  "functions": {
    "app/api/cron/*.ts":                                                    { "maxDuration": 300 },
    "app/api/cron/slot-expiry/route.ts":                                    { "maxDuration": 30  },
    "app/api/admin/events/[id]/communicate/send-next/route.ts":             { "maxDuration": 15  },
    "app/api/admin/events/[id]/communicate/status/route.ts":                { "maxDuration": 10  },
    "app/api/cron/job-worker/route.ts":                                     { "maxDuration": 120 },
    "app/api/admin/leaderboard/recalculate.ts":                             { "maxDuration": 60  },
    "app/api/admin/events/registrations/resend-missing/route.ts":           { "maxDuration": 300 },
    "app/api/admin/events/registrations/reconcile/route.ts":                { "maxDuration": 300 },
    "app/api/attendance/scan/route.ts":                                     { "maxDuration": 30  },
    "app/api/events/register/route.ts":                                     { "maxDuration": 30  },
    "app/api/events/verify-payment/route.ts":                               { "maxDuration": 30  }
  },
  "crons": [
    {
      "path": "/api/cron/job-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/payment-reconcile",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/expiry-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/rank-snapshot",
      "schedule": "0 18 1 * *"
    },
    {
      "path": "/api/cron/session-reminders",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/streak-at-risk",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "30 1 * * 1"
    },
    {
      "path": "/api/cron/birthday-wishes",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/hourly-session-alerts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/slot-expiry",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/media-cleanup",
      "schedule": "30 20 * * *"
    }
  ]
}
